[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/zip;application/x-zip-compressed;application/x-tar;application/x-compressed-tar;application/x-gzip;application/gzip;application/x-bzip;application/x-bzip2;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/x-zstd;application/x-zstd-compressed-tar;application/x-lzma;application/x-lzma-compressed-tar;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-iso9660-image;application/x-cpio;application/x-deb;application/vnd.debian.binary-package;application/x-rpm;application/vnd.comicbook+zip;application/vnd.comicbook-rar;application/x-archive;
Actions=extractHere;extractToSubfolder;extractTo;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Ekstrak
X-KDE-Submenu[en]=Extract
X-KDE-Submenu[id]=Ekstrak

[Desktop Action extractHere]
Name=Extract Here
Name[id]=Ekstrak di Sini
Icon=archive-extract
Exec=quick-extract --here %F

[Desktop Action extractToSubfolder]
Name=Extract to Subfolder
Name[id]=Ekstrak ke Subfolder
Icon=archive-extract
Exec=quick-extract --subfolder %F

[Desktop Action extractTo]
Name=Extract to...
Name[id]=Ekstrak ke...
Icon=document-open-folder
Exec=quick-extract --dialog %F
